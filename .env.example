# SF City Wash — Sales Command Center — Environment Variables
#
# GET /api/health always works with none of these set; the sync loops and the
# API gate just stay off until you add the relevant keys below.

# ── GoHighLevel CRM (Private Integration API Key) ────────────────────────────
# Generate at: GHL → Settings → Integrations → API Keys → Private Integration
# Permissions needed: contacts.readonly, opportunities.readonly, conversations.readonly
# Without it: no leads, pipelines, or conversations sync — the queue stays empty.
GHL_API_KEY=

# ── Setmore (read-only appointments) ─────────────────────────────────────────
# Setmore → Apps & Integrations → API → refresh token.
# Without it: booking status ("already booked, don't call") never resolves.
SETMORE_API_KEY=
# How far back/forward the appointment window is pulled. Defaults shown.
SETMORE_BACK_DAYS=120
SETMORE_FORWARD_DAYS=45

# ── Anthropic (Sales Copilot) ─────────────────────────────────────────────────
# console.anthropic.com → API keys.
# Without it: /api/sales/copilot/* returns 503.
ANTHROPIC_API_KEY=
# Only needed if the key above is an ORGANIZATION-level key rather than one
# scoped to a single workspace (console.anthropic.com → Settings → Workspaces
# → copy the ID). Leave blank for a normal workspace-scoped key.
ANTHROPIC_WORKSPACE_ID=

# ── DASHBOARD_SECRET ──────────────────────────────────────────────────────────
# Optional but strongly recommended once this is deployed anywhere public —
# without it every /api/* route (including customer names and phone numbers)
# is readable by anyone with the URL.
#
# Set this to any long random string and /api/* starts requiring it (as an
# x-dashboard-key header, or a one-time ?key=YOUR_SECRET which the frontend
# stores in localStorage and strips from the address bar). Leave it unset and
# the app behaves exactly as before.
DASHBOARD_SECRET=

# ── WEBHOOK_TOKEN ─────────────────────────────────────────────────────────────
# Not used by any route in this standalone app today (no webhook receiver is
# included here) — reserved for parity with the main SF City Wash dashboard,
# where it lets GoHighLevel workflows call in without holding the full
# DASHBOARD_SECRET.
WEBHOOK_TOKEN=

# ── Storage ────────────────────────────────────────────────────────────────
# Where the SQLite DB (data/sfcw.db) and synced JSON snapshots live. Set this
# to a persistent volume path in production (e.g. Railway) — without it, data
# survives the running process but is wiped on redeploy.
RAILWAY_VOLUME_MOUNT_PATH=

# ── Port ───────────────────────────────────────────────────────────────────
PORT=3002
